# --- Airbnb (Availability section) ---
# Airbnb iCal feed URL. On the Airbnb listing: Calendar > Availability >
# Connect calendars > Export calendar, then copy the .ics link. Treat it like
# a secret: anyone with the link can read the calendar.
AIRBNB_ICAL_URL=

# --- Google Calendar (Availability section) ---
# The owner's manual-blocking calendar (direct weddings, maintenance, personal
# use). In Google Calendar: Settings > the calendar > "Integrate calendar" >
# Calendar ID (an email address, or something@group.calendar.google.com).
GOOGLE_CALENDAR_ID=

# The FULL contents of a Google Cloud service account JSON key file, pasted
# as-is inside single quotes so multi-line JSON survives .env parsing (the
# literal \n sequences in private_key are handled by JSON.parse). Create the
# account at https://console.cloud.google.com/iam-admin/serviceaccounts,
# enable the "Google Calendar API", then share the calendar above with the
# service account's client_email using "See all event details" (read-only;
# never "Make changes"). Never commit this value.
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...",...}'

# --- Inquiry form (Formspree) ---
# Create a form at https://formspree.io, then use its endpoint here, e.g.
# https://formspree.io/f/abcdwxyz
# Must be NEXT_PUBLIC_-prefixed since the form submits directly from the
# browser.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
